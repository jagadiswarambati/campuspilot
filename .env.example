# Gemma 4 / Google AI Studio API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Gemma 4 model identifier (default: gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# AI Provider (gemma)
AI_PROVIDER=gemma

# Set to false once GEMINI_API_KEY is configured to enable live AI reasoning
DEMO_MODE=true

# Application base URL
APP_URL=http://localhost:3000

# JSON database persistence path
DATABASE_PATH=./data/campus-pilot.json
